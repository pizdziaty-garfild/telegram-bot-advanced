# ========================================
# TELEGRAM BOT ADVANCED - CONFIGURATION
# ========================================

# === CORE BOT SETTINGS ===
BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
BOT_MODE=polling
BOT_NAME=Advanced Bot
BOT_VERSION=1.0.0

# === WEBHOOK CONFIGURATION (Production) ===
# WEBHOOK_URL=https://yourdomain.com
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/webhook

# === TLS/SSL CERTIFICATES ===
# TLS_CERT_PATH=certs/cert.pem
# TLS_KEY_PATH=certs/private.key

# === DATABASE ===
# Development (SQLite)
DB_URL=sqlite+aiosqlite:///./data/bot.db

# Production (PostgreSQL)
# DB_URL=postgresql+asyncpg://username:password@localhost:5432/telegram_bot

DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# === SECURITY ===
# Leave empty to auto-generate secure keys
ENC_MASTER_KEY=
JWT_SECRET=

SESSION_TTL=3600

# === ADMIN USERS ===
# Comma-separated list of Telegram user IDs
ADMIN_USERS=123456789,987654321
OWNER_USERS=123456789

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# === SCHEDULING ===
SCHEDULER_TIMEZONE=Europe/Warsaw
SCHEDULER_MAX_WORKERS=10

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# === MONITORING ===
# SENTRY_DSN=https://your-sentry-dsn
HEALTH_CHECK_PORT=8080

# === FEATURE FLAGS ===
ENABLE_TELEMETRY=true
ENABLE_AUDIT_LOG=true
DEBUG_MODE=false

# === CUSTOMIZATION ===
ADMIN_COMMAND_ALIAS=pusher

# ========================================
# NOTES:
# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Generate secure keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. Get your bot token from @BotFather on Telegram
# 5. Find your user ID by messaging @userinfobot
# ========================================