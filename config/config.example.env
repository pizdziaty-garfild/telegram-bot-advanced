# ===== ADVANCED TELEGRAM BOT - EXAMPLE CONFIGURATION =====
# Skopiuj ten plik jako .env w root directory i wypelnij swoje dane

# ===== CORE BOT SETTINGS =====
# Token od @BotFather (WYMAGANE)
BOT_TOKEN=1234567890:ABCdefGhIJKlmnoPQRstuvWXyz123456789

# Tryb pracy bota
BOT_MODE=polling

# Alias komendy admin (mozesz zmienic na /buba, /mama, /ciastko itp.)
ADMIN_COMMAND_ALIAS=pusher

# ===== USER MANAGEMENT =====
# ID wlasciciela bota (twoj Telegram ID) - WYMAGANE
# Aby znalezc swoj ID: napisz do @userinfobot
OWNER_USERS=123456789

# ID adminow (rozdzielone przecinkami)
ADMIN_USERS=987654321,456789123

# ===== DATABASE CONFIGURATION =====
# SQLite (domyslnie, nie wymaga instalacji)
DATABASE_URL=sqlite:///./data/bot.db

# PostgreSQL (opcjonalnie, dla produkcji)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telegram_bot

# Database pool settings
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# ===== SCHEDULER SETTINGS =====
# Timezone dla schedulera (DST-safe)
SCHEDULER_TIMEZONE=Europe/Warsaw

# Maksymalna liczba worker threads
SCHEDULER_MAX_WORKERS=5

# Czas grace dla missed jobs (sekundy)
SCHEDULER_JOB_GRACE_TIME=300

# ===== JOB RETRY SETTINGS =====
# Maksymalna liczba prob ponownych
JOB_MAX_RETRIES=3

# Backoff timing (sekundy)
JOB_RETRY_BACKOFF_MIN=4
JOB_RETRY_BACKOFF_MAX=10

# ===== MIGRATIONS =====
# Automatyczne migracje przy starcie (production: false)
AUTO_MIGRATE=true

# ===== WEBHOOK SETTINGS (opcjonalne) =====
# Tylko dla webhook mode
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/webhook
# WEBHOOK_URL=https://yourdomain.com/webhook
# WEBHOOK_CERT_PATH=certs/cert.pem
# WEBHOOK_KEY_PATH=certs/key.pem

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ===== DEVELOPMENT =====
# Debug mode (wiecej logow)
DEBUG_MODE=false

# ===== TELEMETRY (opcjonalne) =====
# Sentry DSN dla error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
